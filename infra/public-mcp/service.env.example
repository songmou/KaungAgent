ASPNETCORE_ENVIRONMENT=Production
KAUNG_MCP_ADMIN_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AllowedHosts=gold.example.com;localhost;127.0.0.1
McpHost__LocalPort=5091
McpHost__LanEnabled=false
ConnectionStrings__KaungMcp="Data Source=/var/lib/kaungmcp/host.db;Cache=Shared;Default Timeout=30"
McpManagement__LocalEnvPath=/var/lib/kaungmcp/local.env
McpManagement__CertificatePath=/var/lib/kaungmcp/mcp-lan.pfx
Plugins__Directory=/opt/kaungmcp/plugins
Plugins__DataDirectory=/var/lib/kaungmcp/plugins
Scheduler__MaxConcurrency=4
Scheduler__PluginConcurrency=2
Jewelry__Enabled=true
Jewelry__TimeoutSeconds=20
# Pure gold data hosting does not require SearXNG or Chromium.
WebTools__SearchEnabled=false
WebTools__FetchEnabled=false
SEARXNG_DISABLED=true
WebFetch__BrowserFallbackEnabled=false
