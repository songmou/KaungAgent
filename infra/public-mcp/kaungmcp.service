[Unit]
Description=KaungMcp data service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kaungmcp
Group=kaungmcp
WorkingDirectory=/opt/kaungmcp/app
EnvironmentFile=/etc/kaungmcp/service.env
ExecStart=/usr/bin/dotnet /opt/kaungmcp/app/KaungMcp.dll
Restart=always
RestartSec=5
TimeoutStopSec=130
StateDirectory=kaungmcp
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kaungmcp

[Install]
WantedBy=multi-user.target
